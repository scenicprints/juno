# Juno is a no-build static site — almost nothing to ignore.
# Never commit secrets or personal data. (Firebase web config is NOT a secret and MAY be committed.)
.DS_Store
Thumbs.db
*.log
.env
node_modules/

# Juno has no dependencies and no build step. A lockfile here is always an accident
# (an empty one invites `npm ci` and implies a toolchain that does not exist).
package-lock.json
node_modules/
